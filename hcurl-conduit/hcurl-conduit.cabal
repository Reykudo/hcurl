cabal-version: 3.0
name:          hcurl-conduit
version:       0.1.0.0
synopsis:      Conduit response-body streaming for hcurl
description:
  A thin Conduit adapter over the streaming primitives provided by hcurl.

category:      Web
homepage:      https://github.com/Reykudo/hcurl#readme
bug-reports:   https://github.com/Reykudo/hcurl/issues
author:        Diamondy4
maintainer:    diamondy4@hotmail.com
copyright:     2022 Diamondy4
license:       (Apache-2.0 OR MIT)
build-type:    Simple

source-repository head
  type:     git
  location: https://github.com/Reykudo/hcurl

library
  exposed-modules:  HCurl.Conduit
  hs-source-dirs:   src
  default-language: GHC2021
  ghc-options:
    -Wall -Werror=missing-methods -Werror=incomplete-patterns

  build-depends:
    , base        >=4.20.2 && <5
    , bytestring  >=0.12.2 && <0.13
    , conduit     >=1.3.6  && <1.4
    , hcurl       >=0.1    && <0.2
    , resourcet   >=1.3    && <1.4
    , unliftio    >=0.2.25 && <0.3

test-suite hcurl-conduit-test
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  default-language: GHC2021
  ghc-options:
    -Wall -Werror=missing-methods -Werror=incomplete-patterns -threaded
    -rtsopts -with-rtsopts=-N2

  build-depends:
    , async          >=2.2.6  && <2.3
    , base           >=4.20.2 && <5
    , bytestring     >=0.12.2 && <0.13
    , conduit        >=1.3.6  && <1.4
    , hcurl          >=0.1    && <0.2
    , hcurl-conduit  >=0.1    && <0.2
    , network        >=3.2    && <3.3
    , resourcet      >=1.3    && <1.4
    , unliftio       >=0.2.25 && <0.3
